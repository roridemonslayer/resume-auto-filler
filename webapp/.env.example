# Copy this file to .env and fill in real values. Never commit .env.

# Optional: enables "Sign in with Google". This is a public client ID
# (safe to expose in frontend code), not a secret. Must match the
# backend's GOOGLE_CLIENT_ID exactly. Leave unset to disable Google
# sign-in -- the button simply won't render. See DEV.md for how to
# create this in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
