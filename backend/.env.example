# Copy this file to .env and fill in real values. Never commit .env.

# Used to sign JWT session tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# SQLite by default; swap for a Postgres URL in production.
DATABASE_URL=sqlite:///./app.db

# Minutes before a login token expires.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: enables "Sign in with Google" on the web app. Must match the
# webapp's VITE_GOOGLE_CLIENT_ID exactly. Leave unset to disable Google
# sign-in (the button just won't render). See webapp/DEV.md for how to
# create this in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Optional: enables the welcome email sent on signup. Leave unset to
# skip sending (signup still succeeds either way). Get a free API key
# at https://resend.com -- see backend/DEV.md for the exact steps.
RESEND_API_KEY=
EMAIL_FROM=Resume Auto-Filler <onboarding@resend.dev>
